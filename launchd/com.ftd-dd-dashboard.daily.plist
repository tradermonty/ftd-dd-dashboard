<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the daily job. NOT installed and NOT loaded: the owner decides.

  Weekdays at 15:00 local time. The Mac is on Pacific time, so this is 18:00 US Eastern
  (two hours after the close); both zones change to summer time on the same day, so it stays
  18:00 Eastern all year. launchd runs a missed job when the Mac wakes up.

  To install (when you decide to):
    sed "s#__PROJECT_DIR__#$PWD#g" launchd/com.ftd-dd-dashboard.daily.plist \
      > ~/Library/LaunchAgents/com.ftd-dd-dashboard.daily.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.ftd-dd-dashboard.daily.plist
  To remove:
    launchctl bootout gui/$(id -u)/com.ftd-dd-dashboard.daily

  The job is scripts/run_daily.sh. It reads FMP_API_KEY (and optionally PLAYWRIGHT_PYTHON)
  from .env in the project directory.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ftd-dd-dashboard.daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_DIR__/scripts/run_daily.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/launchd.err.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
